# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Frontend Origin (CORS) ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=junubi
DB_PASSWORD=yourpassword
DB_NAME=junubi_tech

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP / Nodemailer) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@junubitech.com
SMTP_PASS=yoursmtppassword
SMTP_FROM="Junubi Technologies <hello@junubitech.com>"

# ─── Admin Notification ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@junubitech.com
