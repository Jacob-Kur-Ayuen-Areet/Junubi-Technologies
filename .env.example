# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=junubi
DB_PASSWORD=junubi_secret
DB_NAME=junubi_tech

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_long_random_secret_string_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_long_random_secret_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@junubitech.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Junubi Technologies <hello@junubitech.com>"
ADMIN_EMAIL=admin@junubitech.com
