# ─── Server & App ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://www.junubitech.com

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_HOST must be "mysql" when using Docker Compose
DB_HOST=mysql
DB_PORT=3306
DB_USER=junubi
DB_PASSWORD=JunubiPass2026!
DB_NAME=junubi_tech
MYSQL_ROOT_PASSWORD=JunubiRoot2026!

# ─── JWT  (generate with: openssl rand -hex 32) ───────────────────────────────
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@junubitech.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Junubi Technologies <hello@junubitech.com>"
ADMIN_EMAIL=admin@junubitech.com
